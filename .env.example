# AI Provider Configuration (groq | gemini | openrouter | mock)
# If left blank, defaults automatically to 'groq' if GROQ_API_KEY is present, or 'mock' for offline testing.
AI_PROVIDER=mock

# Groq Configuration (Recommended - 100% Free & Fast)
# Obtain your free key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini Configuration (Alternative Free Tier)
# Obtain your free key at: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter Configuration (Alternative)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Site URL for SEO & OpenGraph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
